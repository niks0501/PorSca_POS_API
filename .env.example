APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Sanctum bearer token lifetime in minutes (30 days). Set to 0 or empty for no expiry.
SANCTUM_EXPIRATION=43200

# First admin account for `php artisan db:seed`. The password is only used when
# the account does not exist yet, so re-seeding never resets a changed password.
ADMIN_NAME="Store Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# QR Ph is sandbox-only. Never use production credentials or endpoints here.
PAYMONGO_MODE=sandbox
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# QR Ph sandbox codes expire after 30 minutes by default (PayMongo allows 60-9000 seconds).
PAYMONGO_QR_EXPIRY_SECONDS=1800
PAYMONGO_SANDBOX_ENDPOINT=https://api.paymongo.com/v1/payment_intents

# Durable checkout v3. Hold/QR durations align but are persisted separately.
CHECKOUT_STORE_ID=porsca
CHECKOUT_HOLD_SECONDS=1800
# Provisional staging QR minimum, not a discovered provider/account limit.
CHECKOUT_QR_MINIMUM_CENTAVOS=100
# Leave false until operator-owned provider gates are validated in approved staging.
CHECKOUT_SIMULATION_ENABLED=false
CHECKOUT_PROVIDER_FINALITY_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# For a shared staging machine use DB_DATABASE=porsca_staging (MySQL/Postgres) or an absolute SQLite path.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=PorSca_POS
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
